[Unit]
Description=Single EK9500 EtherNet/IP to Modbus TCP Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ek9500gw
Group=ek9500gw
RuntimeDirectory=ek9500-modbus-gateway
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/ek9500_modbus_tcp_gateway /etc/ek9500-modbus-gateway/gateway.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/ek9500-modbus-gateway
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
